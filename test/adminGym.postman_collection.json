    {
      "name": "auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const numero = Math.floor(Math.random() * 1000000);\r\nconst username = `usuario${numero}`;\r\npm.collectionVariables.set(\"username\", username);\r\n\r\n"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registro exitoso\", function () {\r\n    pm.response.to.have.status(201);\r\n\r\n    const response = pm.response.json();\r\n\r\n    pm.collectionVariables.set(\"email\", response.user.email);\r\n    pm.collectionVariables.set(\"token\", response.token);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{$randomUserName}}\",\r\n  \"username\": \"{{username}}\",\r\n  \"email\": \"{{$randomEmail}}\",\r\n  \"password\": \"cliente1\",\r\n  \"confirmPassword\": \"cliente1\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\n\r\npm.collectionVariables.set(\"token\", response.token);\r\n\r\npm.test(\"Login exitoso\", function () {\r\n    pm.response.to.have.status(200);    \r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"identificador\": \"{{email}}\",\r\n  \"password\": \"{{password}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
