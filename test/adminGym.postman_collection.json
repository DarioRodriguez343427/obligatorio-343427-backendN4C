              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const disciplinas = [\"Futbol\",\"Basquetbol\",\"Tenis\",\"Natacion\",\"Boxeo\",\"Karate\",\"Voleibol\",\"Atletismo\",\"Hockey\",\"Ciclismo\"];\r\n\r\nconst posicionAleatoria = Math.floor(Math.random() * disciplinas.length);\r\nconst disciplina = disciplinas[posicionAleatoria];\r\n\r\nconst numero = Math.floor(Math.random() * 1000000);\r\nconst username = `clase de ${disciplina}-${numero}`;\r\n\r\npm.collectionVariables.set(\"disciplina_random\", disciplina);\r\npm.collectionVariables.set(\"username\", username);"
                ]
              }
            }
          ],
